+
+/* ===== BorderBeam (animated glowing border) ===== */
+@property --beam-a { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
+@keyframes cw-beam-spin { to { --beam-a: 360deg; } }
+.beam{ position:relative; }
+.beam-inner{ position:relative; z-index:2; overflow:hidden; }
+.beam::before,.beam::after{
+  content:""; position:absolute; inset:0; border-radius:inherit; padding:var(--beam-w,2px);
+  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
+  -webkit-mask-composite:xor; mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
+  mask-composite:exclude; pointer-events:none;
+  animation:cw-beam-spin var(--beam-dur,6s) linear infinite;
+}
+.beam::before{ z-index:3; }
+.beam::after{ z-index:1; filter:blur(7px); opacity:.7; }
+.beam--sm{ --beam-w:1.5px } .beam--md{ --beam-w:2px } .beam--lg{ --beam-w:3px }
+.beam--colorful::before,.beam--colorful::after{
+  background:conic-gradient(from var(--beam-a), transparent 0deg 250deg, #2b62d6 300deg, #37c7ff 330deg, #a06bff 350deg, transparent 360deg);
+}
+.beam--blue::before,.beam--blue::after{
+  background:conic-gradient(from var(--beam-a), transparent 0deg 285deg, #2b62d6 330deg, #7fb0ff 352deg, transparent 360deg);
+}
+@media (prefers-reduced-motion: reduce){ .beam::before,.beam::after{ animation:none } }
+
+/* ===== Chat widget ===== */
+.cw-launcher{
+  position:fixed; right:22px; bottom:22px; z-index:80;
+  display:inline-flex; align-items:center; gap:9px; height:52px; padding:0 20px 0 16px;
+  border:none; border-radius:30px; cursor:pointer;
+  color:#eef2f8; background:linear-gradient(180deg,#232529,#17181c);
+  box-shadow:0 10px 30px rgba(9,12,20,.35), inset 0 0 0 1px rgba(255,255,255,.06), 0 0 0 1px rgba(43,98,214,.35);
+  font:600 13.5px/1 "Helvetica Neue",Arial,"Segoe UI",sans-serif; letter-spacing:.02em;
+  transition:transform .25s ease, box-shadow .25s ease, opacity .2s ease;
+}
+.cw-launcher:hover{ transform:translateY(-2px); box-shadow:0 14px 34px rgba(9,12,20,.42), inset 0 0 0 1px rgba(255,255,255,.08), 0 0 0 1px rgba(43,98,214,.6); }
+.cw-launcher svg{ color:#7fb0ff }
+.cw-launch-label{ white-space:nowrap }
+.cw-launch-dot{ position:absolute; top:12px; right:16px; width:8px; height:8px; border-radius:50%; background:#37c7ff; box-shadow:0 0 0 3px rgba(55,199,255,.25); }
+.cw-hidden{ opacity:0; pointer-events:none; transform:translateY(10px) scale(.9); }
+
+.cw-panel{
+  position:fixed; right:22px; bottom:22px; z-index:81;
+  width:min(384px, calc(100vw - 32px));
+  opacity:0; transform:translateY(16px) scale(.98); pointer-events:none;
+  transition:opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1);
+}
+.cw-panel.cw-open{ opacity:1; transform:none; pointer-events:auto; }
+
+.cw-card{
+  display:flex; flex-direction:column;
+  height:min(596px, calc(100vh - 120px));
+  background:#171820; color:#e8eaee;
+  font-family:"Helvetica Neue",Arial,"Segoe UI",sans-serif;
+}
+.cw-head{
+  display:flex; align-items:center; gap:11px; padding:14px 14px 13px;
+  border-bottom:1px solid rgba(255,255,255,.07);
+  background:linear-gradient(180deg,#1c1e27,#171820);
+}
+.cw-avatar{ display:grid; place-items:center; width:36px; height:36px; border-radius:11px;
+  color:#bcd4ff; background:radial-gradient(120% 120% at 30% 20%, #2b62d6, #1a2740);
+  box-shadow:inset 0 0 0 1px rgba(255,255,255,.08); }
+.cw-head-txt{ flex:1; min-width:0 }
+.cw-title{ font-size:13.5px; font-weight:700; letter-spacing:.01em }
+.cw-sub{ display:flex; align-items:center; gap:6px; font-size:11px; color:#9aa0ac; margin-top:2px }
+.cw-online{ width:7px; height:7px; border-radius:50%; background:#37d07a; box-shadow:0 0 0 3px rgba(55,208,122,.18) }
+.cw-x{ display:grid; place-items:center; width:30px; height:30px; border:none; border-radius:9px; cursor:pointer;
+  color:#aeb4bf; background:rgba(255,255,255,.05); transition:background .2s,color .2s }
+.cw-x:hover{ background:rgba(255,255,255,.1); color:#fff }
+
+.cw-msgs{ flex:1; overflow-y:auto; padding:16px 14px; display:flex; flex-direction:column; gap:10px; }
+.cw-msgs::-webkit-scrollbar{ width:8px } .cw-msgs::-webkit-scrollbar-thumb{ background:rgba(255,255,255,.1); border-radius:8px }
+.cw-msg{ display:flex; max-width:100% }
+.cw-msg.cw-u{ justify-content:flex-end }
+.cw-bubble{ max-width:82%; padding:10px 13px; font-size:13.5px; line-height:1.5; border-radius:15px; white-space:pre-wrap; word-wrap:break-word; }
+.cw-a .cw-bubble{ background:#262932; color:#e6e9ef; border-bottom-left-radius:5px; box-shadow:inset 0 0 0 1px rgba(255,255,255,.04) }
+.cw-u .cw-bubble{ background:linear-gradient(180deg,#2f6be0,#2b62d6); color:#fff; border-bottom-right-radius:5px }
+.cw-a .cw-bubble b, .cw-a .cw-bubble strong{ color:#fff }
+.cw-typing{ display:inline-flex; gap:5px; align-items:center }
+.cw-typing span{ width:6px; height:6px; border-radius:50%; background:#8b93a2; animation:cw-dot 1.2s infinite ease-in-out }
+.cw-typing span:nth-child(2){ animation-delay:.18s } .cw-typing span:nth-child(3){ animation-delay:.36s }
+@keyframes cw-dot{ 0%,60%,100%{ transform:translateY(0); opacity:.4 } 30%{ transform:translateY(-4px); opacity:1 } }
+.cw-waking{ font-size:11px; color:#8b93a2; text-align:center; padding:2px 8px }
+
+.cw-form{ display:flex; align-items:flex-end; gap:8px; padding:11px 12px; border-top:1px solid rgba(255,255,255,.07); background:#14151c }
+.cw-input{ flex:1; resize:none; max-height:120px; padding:10px 12px; font:inherit; font-size:13.5px; line-height:1.4;
+  color:#e8eaee; background:#20222b; border:1px solid rgba(255,255,255,.08); border-radius:13px; outline:none; }
+.cw-input::placeholder{ color:#6b7280 }
+.cw-input:focus{ border-color:rgba(43,98,214,.6) }
+.cw-send{ flex:none; display:grid; place-items:center; width:40px; height:40px; border:none; border-radius:12px; cursor:pointer;
+  color:#fff; background:linear-gradient(180deg,#2f6be0,#2b62d6); transition:opacity .2s, transform .15s }
+.cw-send:hover:not(:disabled){ transform:translateY(-1px) }
+.cw-send:disabled{ opacity:.4; cursor:default }
+
+@media (max-width:520px){
+  .cw-panel{ right:12px; left:12px; bottom:12px; width:auto }
+  .cw-card{ height:min(72vh, calc(100vh - 96px)) }
+  .cw-launcher{ right:14px; bottom:14px }
+}
